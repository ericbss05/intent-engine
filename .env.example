# Noms de variables uniquement. Ne JAMAIS mettre de vraies valeurs ici ni commiter .env
# Copier ce fichier en .env (backend) / .env.local (front) puis remplir en local.

# --- Général
APP_ENV=development        # development | test | production
LOG_LEVEL=info             # debug | info | warning | error

# --- Front -> Backend
# Front (apps/web/.env.local) : URL publique de l'API. Visible dans le navigateur : pas de secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Backend (apps/api/.env) : origines autorisées par le CORS, séparées par des virgules. Jamais "*".
API_ALLOWED_ORIGINS=http://localhost:3000

# --- Base de données (partie 1 ; Neon, région Frankfurt)
# DATABASE_URL : adresse « pooled » de Neon (hôte contenant « -pooler »), utilisée par l'application.
DATABASE_URL=
# DATABASE_URL_DIRECT : adresse directe (sans « -pooler »), utilisée seulement par Alembic (migrations).
DATABASE_URL_DIRECT=
# Tests uniquement : PostgreSQL local jetable (le nom de la base DOIT finir par _test).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/stagefinder_test

# --- Clerk (partie 1)
# Front (apps/web/.env.local) : clé publique (pk_test_… / pk_live_…), visible dans le navigateur.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Backend (apps/api/.env) : clé secrète (sk_…) ; sert seulement à supprimer le compte Clerk (DELETE /me).
CLERK_SECRET_KEY=
# Backend : secret de signature du webhook (whsec_…), donné par Clerk quand on crée le endpoint.
CLERK_WEBHOOK_SECRET=
# Backend : URL de l'instance Clerk, ex. https://xxxx.clerk.accounts.dev (sans « / » final, en https).
CLERK_JWT_ISSUER=
# Rôle admin : dans Clerk, mettre {"role": "admin"} dans les « public metadata » de l'utilisateur,
# et dans Sessions > Customize session token : {"metadata": "{{user.public_metadata}}"}.

# --- Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Sources (à ouvrir quand la partie correspondante démarre)
INSEE_API_KEY=
BRIGHTDATA_API_KEY=
FIRECRAWL_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=
REOON_API_KEY=

# --- IA (partie 5 ; seulement si les portes sont ouvertes)
LLM_PROVIDER=
LLM_API_KEY=
LLM_REGION=eu

# --- Surveillance (optionnel, sans données personnelles)
SENTRY_DSN=
