# Noms de variables uniquement. Ne JAMAIS mettre de vraies valeurs ici ni commiter .env

# --- Général
APP_ENV=development
LOG_LEVEL=info

# --- Base de données (Neon, région Frankfurt)
DATABASE_URL=

# --- Clerk (front + vérification du jeton côté backend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER=

# --- Front -> Backend
NEXT_PUBLIC_API_BASE_URL=
API_ALLOWED_ORIGINS=

# --- Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Sources (à ouvrir quand la partie correspondante démarre)
INSEE_API_KEY=
BRIGHTDATA_API_KEY=
FIRECRAWL_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=
REOON_API_KEY=

# --- IA (partie 5 ; seulement si les portes sont ouvertes)
LLM_PROVIDER=
LLM_API_KEY=
LLM_REGION=eu

# --- Surveillance (optionnel, sans données personnelles)
SENTRY_DSN=
